=begin catalog: script-when-loaded=onLoaded, \
                script-when-media-control@play=onMediaControlPlay, \
                script-when-media-control@pause=onMediaControlPause, \
                script-when-media-control@next=onMediaControlNext, \
                script-when-media-control@prev=onMediaControlPrev, \
                script-when-media-control@seek=onMediaControlSeek

=object youtube: id=youtube, updates-now-playing-info=yes, script-when-finished=onVideoFinished, style=youtube

=begin actions
=(object button: label=@{Prev}, script=prev, style=btn_action)=\
=(object button: label=@{Next}, script=next, style=btn_action)=
=end actions

=end catalog
