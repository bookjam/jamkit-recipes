=begin catalog

=style player: info-hidden=yes, control-hidden=yes, ignores-touches=yes, quality=hd1080, \
            script-when-playing=onVideoPlaying, \
            script-when-finished=onVideoFinished

=object youtube: id=youtube.1, style=player, style=youtube
=object youtube: id=youtube.2, style=player, style=youtube
=object youtube: id=youtube.3, style=player, style=youtube

=object showcase: id=showcase.videos, data-script=feedVideos, alternate-name=videos, background-loading=yes, \
            script-when-paging-done=onPagingDone, \
            style=showcase_videos

=end catalog
